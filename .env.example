# TripMind AI - Optional Environment Variables
# The app works out-of-the-box with full mock generation (zero API keys needed).

# Active AI Provider: 'mock' (default), 'openai', or 'gemini'
VITE_AI_PROVIDER=mock

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Production AI Gateway (Google Gemini):
# AI requests are routed through the secure Supabase Edge Function ('tripmind-ai').
# GEMINI_API_KEY is configured strictly as a Supabase Edge Function secret.
# Never expose GEMINI_API_KEY in client-side .env or VITE_* variables.

# Optional live weather API key:
# VITE_WEATHER_API_KEY=...

# Optional Mapbox token for live interactive WebGL vector tiles:
# VITE_MAPBOX_TOKEN=pk....
