# TripMind AI - Optional Environment Variables
# The app works out-of-the-box with full mock generation (zero API keys needed).

# Active AI Provider: 'mock' (default), 'openai', or 'gemini'
VITE_AI_PROVIDER=mock

# Optional for live AI generation (or use a secure server proxy):
# VITE_OPENAI_API_KEY=sk-...
# VITE_GEMINI_API_KEY=AIzaSy...

# Optional live weather API key:
# VITE_WEATHER_API_KEY=...

# Optional Mapbox token for live interactive WebGL vector tiles:
# VITE_MAPBOX_TOKEN=pk....
